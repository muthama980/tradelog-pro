# =============================================================================
# TradeLog Pro — Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ---- Supabase --------------------------------------------------------------
# Find these in your Supabase project at Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Site URL --------------------------------------------------------------
# Used for OAuth redirects and Lemon Squeezy success URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Lemon Squeezy ---------------------------------------------------------
# Create products in Lemon Squeezy and copy the variant IDs here
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

LS_VARIANT_CORE=000000      # Variant ID for Core ($19/mo)
LS_VARIANT_PRO=000000       # Variant ID for Pro ($25/mo)
LS_VARIANT_PROP=000000      # Variant ID for Prop Trader ($30/mo)

# ---- Paystack --------------------------------------------------------------
# Create an account at paystack.com, then copy keys from Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Run `npx ts-node scripts/create-paystack-plans.ts` once to create plans,
# then paste the returned plan codes here.
PAYSTACK_PLAN_CORE=PLN_xxx    # Core plan  — KES 1,900/month
PAYSTACK_PLAN_PRO=PLN_xxx     # Pro plan   — KES 2,500/month
PAYSTACK_PLAN_PROP=PLN_xxx    # Prop Trader — KES 3,000/month

# ---- NOWPayments (Crypto) --------------------------------------------------
# Sign up at nowpayments.io, create an API key, and set an IPN secret in your dashboard
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# ---- Anthropic Claude ------------------------------------------------------
# Powers the AI Coach feature
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Google Analytics ------------------------------------------------------
# Get your Measurement ID from Google Analytics → Admin → Data Streams → your stream → Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
